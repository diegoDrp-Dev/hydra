datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  scans     Scan[]
  incidents Incident[]
  alerts    AlertSubscription[]
  role      UserRole @default(ANALYST)
  auditLogs AuditLog[]
  memberships TenantMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  memberships TenantMembership[]
  events      SecurityEvent[]
  rules       DetectionRule[]
  matches     DetectionMatch[]
  auditLogs   AuditLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      UserRole @default(ANALYST)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
}

enum UserRole {
  ANALYST
  ADMIN
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  outcome      String   @default("SUCCESS")
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model SecurityEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp          DateTime
  ingestionTimestamp DateTime @default(now())
  source             String
  sourceType         String
  category           String
  action             String
  outcome            String?
  severity           String   @default("informational")
  host               Json?
  user               Json?
  process            Json?
  network            Json?
  file               Json?
  cloud              Json?
  rawEvent            Json
  metadata            Json?
  deduplicationKey    String
  matches             DetectionMatch[]

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, timestamp])
  @@index([tenantId, category, action])
  @@index([tenantId, sourceType])
}

model DetectionRule {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  description        String
  version            Int      @default(1)
  status             String   @default("draft")
  severity           String
  conditions         Json
  dataSources        String[]
  mitreTechniques    String[]
  tags               String[]
  authorId           String
  falsePositiveNotes String?
  references         String[]
  matches            DetectionMatch[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

model DetectionMatch {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String
  event     SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      DetectionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  severity  String
  reason    Json
  createdAt DateTime      @default(now())

  @@unique([eventId, ruleId])
  @@index([tenantId, createdAt])
  @@index([ruleId, createdAt])
}

model Scan {
  id         String   @id @default(cuid())
  url        String
  statusCode Int?
  duration   Int?

  score      Int?
  severity   String?
  issues     String[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  headers    ScanHeader?
  risks      Risk[]
  incident   Incident?  @relation("ScanToIncident")

  user       User? @relation(fields: [userId], references: [id])
  userId     String?
}

model ScanHeader {
  id                      String @id @default(cuid())
  scanId                  String @unique
  xContentTypeOptions     String?
  strictTransportSecurity String?
  contentSecurityPolicy   String?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model Risk {
  id          String   @id @default(cuid())
  scanId      String
  ruleId      String
  severity    String   // low, medium, high, critical
  score       Int      // 0-100
  description String
  remediation String?
  createdAt   DateTime @default(now())

  scan        Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  incidentId  String?
  incident    Incident? @relation("RiskToIncident", fields: [incidentId], references: [id])

  @@index([scanId])
  @@index([severity])
}

model Incident {
  id              String   @id @default(cuid())
  title           String
  description     String
  severity        String   // low, medium, high, critical
  status          String   @default("open") // open, investigating, resolved, false_positive
  riskScore       Int      // 0-100
  deduplicationKey String   @unique // Hash for deduplication
  
  scanId          String?  @unique
  scan            Scan?    @relation("ScanToIncident", fields: [scanId], references: [id])
  
  risks           Risk[]   @relation("RiskToIncident")
  alerts          Alert[]
  
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([userId])
  @@index([deduplicationKey])
}

model Alert {
  id          String   @id @default(cuid())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId  String
  
  webhookUrl  String?
  webhookType String?  // discord, slack, generic
  status      String   @default("pending") // pending, sent, failed
  
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([incidentId])
  @@index([status])
}

model AlertSubscription {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  webhookUrl  String
  webhookType String   // discord, slack, generic
  severities  String[] @default(["critical", "high"]) // Filter by severity
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, webhookUrl])
  @@index([userId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  webhookUrl  String
  incidentId  String
  
  statusCode  Int?
  error       String?
  retries     Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([webhookUrl])
}
