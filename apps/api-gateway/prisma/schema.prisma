datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  scans     Scan[]
  incidents Incident[]
  alerts    AlertSubscription[]
  role      UserRole @default(ANALYST)
  auditLogs AuditLog[]
  memberships TenantMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  memberships TenantMembership[]
  events      SecurityEvent[]
  rules       DetectionRule[]
  matches     DetectionMatch[]
  auditLogs   AuditLog[]
  securityAlerts SecurityAlert[]
  cases       CaseRecord[]
  entityRisks EntityRisk[]
  playbooks   Playbook[]
  playbookExecutions PlaybookExecution[]
  threatIndicators ThreatIndicator[]
  correlationRules CorrelationRule[]
  correlationSignals CorrelationSignal[]
  socIncidents SocIncident[]
  featureFlags FeatureFlag[]
  retentionPolicies RetentionPolicy[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      UserRole @default(ANALYST)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
}

enum UserRole {
  ANALYST
  ADMIN
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  outcome      String   @default("SUCCESS")
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model SecurityEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp          DateTime
  ingestionTimestamp DateTime @default(now())
  source             String
  sourceType         String
  category           String
  action             String
  outcome            String?
  severity           String   @default("informational")
  host               Json?
  user               Json?
  process            Json?
  network            Json?
  file               Json?
  cloud              Json?
  rawEvent            Json
  metadata            Json?
  deduplicationKey    String
  matches             DetectionMatch[]

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, timestamp])
  @@index([tenantId, category, action])
  @@index([tenantId, sourceType])
}

model DetectionRule {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  description        String
  version            Int      @default(1)
  status             String   @default("draft")
  severity           String
  conditions         Json
  dataSources        String[]
  mitreTechniques    String[]
  tags               String[]
  authorId           String
  falsePositiveNotes String?
  references         String[]
  matches            DetectionMatch[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

model DetectionMatch {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String
  event     SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      DetectionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  severity  String
  reason    Json
  createdAt DateTime      @default(now())
  alert     SecurityAlert?

  @@unique([eventId, ruleId])
  @@index([tenantId, createdAt])
  @@index([ruleId, createdAt])
}

model SecurityAlert {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    String
  confidence  Int      @default(50)
  riskScore   Int
  status      String   @default("new")
  source      String
  ruleId      String?
  eventId     String?
  matchId     String?  @unique
  match       DetectionMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  entities    Json?
  mitre       String[]
  assigneeId  String?
  caseId      String?
  case        CaseRecord? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  incidentId  String?
  incident    SocIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  timeline    TimelineEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, severity])
  @@index([tenantId, riskScore])
}

model CorrelationRule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String
  status        String   @default("draft")
  windowMinutes Int
  threshold     Int
  groupBy       String
  severities    String[]
  outputSeverity String
  mitreTechniques String[]
  signals       CorrelationSignal[]
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model CorrelationSignal {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        CorrelationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityKey   String
  alertIds    String[]
  score       Int
  incidentId  String?
  incident    SocIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([ruleId, entityKey, createdAt])
}

model SocIncident {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    String
  priority    String
  status      String   @default("new")
  riskScore   Int
  ownerId     String?
  deduplicationKey String
  alerts      SecurityAlert[]
  signals     CorrelationSignal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, riskScore])
}

model CaseRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String   @default("medium")
  status      String   @default("open")
  ownerId     String?
  alerts      SecurityAlert[]
  timeline    TimelineEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status, updatedAt])
}

model TimelineEntry {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String?
  case      CaseRecord? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  alertId   String?
  alert     SecurityAlert? @relation(fields: [alertId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String?
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([caseId, createdAt])
}

model EntityRisk {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String
  entityKey  String
  score      Int
  reasons    Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([tenantId, entityType, entityKey])
  @@index([tenantId, score])
}

model Playbook {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("draft")
  actions     Json
  createdBy   String
  executions  PlaybookExecution[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

model PlaybookExecution {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playbookId  String
  playbook    Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  status      String   @default("pending_approval")
  requestedBy String
  approvedBy  String?
  input       Json?
  result      Json?
  idempotencyKey String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
}

model ThreatIndicator {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  value       String
  confidence  Int
  severity    String
  source      String
  validUntil  DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, type, value, source])
  @@index([tenantId, type, value])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model RetentionPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource    String
  retentionDays Int
  enabled     Boolean  @default(true)
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, resource])
}

model Scan {
  id         String   @id @default(cuid())
  url        String
  statusCode Int?
  duration   Int?

  score      Int?
  severity   String?
  issues     String[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  headers    ScanHeader?
  risks      Risk[]
  incident   Incident?  @relation("ScanToIncident")

  user       User? @relation(fields: [userId], references: [id])
  userId     String?
}

model ScanHeader {
  id                      String @id @default(cuid())
  scanId                  String @unique
  xContentTypeOptions     String?
  strictTransportSecurity String?
  contentSecurityPolicy   String?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}

model Risk {
  id          String   @id @default(cuid())
  scanId      String
  ruleId      String
  severity    String   // low, medium, high, critical
  score       Int      // 0-100
  description String
  remediation String?
  createdAt   DateTime @default(now())

  scan        Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)

  incidentId  String?
  incident    Incident? @relation("RiskToIncident", fields: [incidentId], references: [id])

  @@index([scanId])
  @@index([severity])
}

model Incident {
  id              String   @id @default(cuid())
  title           String
  description     String
  severity        String   // low, medium, high, critical
  status          String   @default("open") // open, investigating, resolved, false_positive
  riskScore       Int      // 0-100
  deduplicationKey String   @unique // Hash for deduplication
  
  scanId          String?  @unique
  scan            Scan?    @relation("ScanToIncident", fields: [scanId], references: [id])
  
  risks           Risk[]   @relation("RiskToIncident")
  alerts          Alert[]
  
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([userId])
  @@index([deduplicationKey])
}

model Alert {
  id          String   @id @default(cuid())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId  String
  
  webhookUrl  String?
  webhookType String?  // discord, slack, generic
  status      String   @default("pending") // pending, sent, failed
  
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([incidentId])
  @@index([status])
}

model AlertSubscription {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  webhookUrl  String
  webhookType String   // discord, slack, generic
  severities  String[] @default(["critical", "high"]) // Filter by severity
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, webhookUrl])
  @@index([userId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  webhookUrl  String
  incidentId  String
  
  statusCode  Int?
  error       String?
  retries     Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([webhookUrl])
}
